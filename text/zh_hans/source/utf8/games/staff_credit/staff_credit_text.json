  {
    "key": "D_08069dac",
    "original": "(C)2006 Nintendo/J.P.ROOM",
    "translation": "(C)2006 Nintendo/J.P.ROOM",
    "stage": 5
  },
  {
    "key": "D_08069dc8",
    "original": "おつかれさま！",
    "translation": "辛苦了。",
    "stage": 5
  },
  {
    "key": "D_08069ddc",
    "original": "がんばりましたネ！\nあなたの　リズム感、\n良くなっていると\nうれしいな。",
    "translation": "你真的很努力呢！\n你的节奏感要是\n变得更好了，我会很开心的。\n",
    "stage": 5
  },
  {
    "key": "D_08069e24",
    "original": "クリアしたゲームは\nなれたころが　いちばん\n楽しいから、またあとで\nあそんでみてネ！",
    "translation": "已经通关的游戏，\n往往是玩熟了以后\n才最有意思，所以之后也\n再拿出来玩玩看吧！",
    "stage": 5
  },
  {
    "key": "D_08069e78",
    "original": "ゲームは、あとすこしだけ\nつづくんだけど、ここで\nスタッフのメンバー紹介を\nさせてくださいネ。",
    "translation": "后面还有一点内容，\n不过先在这里\n给你介绍一下\n制作人员吧。",
    "stage": 5
  },
  {
    "key": "D_08069ed4",
    "original": "では、どうぞ〜！",
    "translation": "那么，请看吧〜！",
    "stage": 5
  },
  {
    "key": "D_08069ee8",
    "original": "こんにちは！",
    "translation": "你好呀！",
    "stage": 5
  },
  {
    "key": "D_08069ef8",
    "original": "がんばってますか？\nあなたの　リズム感、\n良くなっていると\nうれしいな。",
    "translation": "还在加油吗？\n你的节奏感要是\n变得更好了，我会很开心的。\n",
    "stage": 5
  },
  {
    "key": "D_08069f40",
    "original": "クリアしたゲームは\nなれたころが　いちばん\n楽しいから、何回も\nあそんでみてネ！",
    "translation": "已经通关的游戏，\n往往是玩熟了以后\n才最有意思，所以也要\n多玩几次哦！",
    "stage": 5
  },
  {
    "key": "D_08069f90",
    "original": "そうそう、\nゲームのスタッフでしたね。\n今は、どんなゲームを\n作ってるんでしょうねぇ…",
    "translation": "对了，还得介绍\n游戏的制作人员呢。\n不知道他们现在\n又在做什么游戏呢…",
    "stage": 5
  },
  {
    "key": "D_08069fe4",
    "original": "ま、それはさておき。\nでは、どうぞ〜！",
    "translation": "好了，先不说这个。\n那么，请看吧〜！",
    "stage": 5
  }
]